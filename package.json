{
  "name": "@qawolf/eslint-plugin-pom",
  "version": "0.5.0",
  "description": "ESLint rules for QA Wolf page objects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qawolf/eslint-plugin-pom.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "/dist",
    "/LICENSE",
    "/README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "lint": "eslint . --ext cjs,cts,js,jsx,mjs,ts,tsx --quiet && prettier --check .",
    "lint:fix": "eslint . --ext cjs,cts,js,jsx,mjs,ts,tsx --fix --quiet && prettier --log-level=warn --write .",
    "prepublishOnly": "npm run build",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" NODE_NO_WARNINGS=1 jest",
    "test:watch": "npm run test -- --watch",
    "tsc:check": "tsc"
  },
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "devDependencies": {
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@tsconfig/strictest": "^2.0.5",
    "@types/eslint": "^8.56.12",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  }
}
